<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!--
    The backend is a PyInstaller onedir folder (Contents/Resources/sidecar)
    whose executable dlopen()s its own ad-hoc-signed Python.framework and
    native libraries. Under the hardened runtime (adhoc,runtime) library
    validation rejects code with a different Team ID ("different Team IDs"),
    which killed the sidecar on launch when it was a one-file binary Tauri
    signed itself. Kept disabled so any process the app's signature covers
    can still load those libraries.
  -->
  <key>com.apple.security.cs.disable-library-validation</key>
  <true/>
</dict>
</plist>
